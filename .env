# LiveKit config — agent uses localhost, browsers use wss:// via proxy
# livekit-server runs on 127.0.0.1:7880 (internal, plain ws)
# wss_proxy listens on 0.0.0.0:7443 (external, TLS) → forwards to :7880
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_EXTERNAL_URL=wss://100.126.67.88:7443
LIVEKIT_BIND_PORT=7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=100.126.67.88
MANAGE_LIVEKIT=1

# LLM — use existing ollama service instead of managing llama-server
LLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMA_MODEL=gemma4:12b
LLAMA_API_KEY=no-key-needed
MANAGE_LLAMA=0
HF_HUB_OFFLINE=1
LLAMA_CTX_SIZE=16384

# STT — Qwen3-ASR (multilingual, Chinese-capable, runs on CUDA)
STT_PROVIDER=qwen_asr
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_MODEL=qwen3-asr-1.7b
STT_API_KEY=no-key-needed
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
DEVICE=cuda

# TTS — Qwen3-TTS (CustomVoice, Chinese, preset speakers)
TTS_PROVIDER=qwen_tts
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE=Vivian
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
QWEN_TTS_SPEAKER=Vivian
QWEN_TTS_LANGUAGE=Auto

# Web (FastAPI: token route + static frontend)
# Use 8083 to avoid conflict with agent worker default (8081)
WEB_PORT=8083
SSL_CERTFILE=./cert.pem
SSL_KEYFILE=./key.pem

# Agent worker HTTP port (must differ from WEB_PORT)
WORKER_PORT=8082

# Optional Whisper fallback (STT_PROVIDER=whisper)
# WHISPER_MODEL is set above to the large-v3 multilingual model

# Path to the statically-exported Next.js frontend
FRONTEND_DIR=./frontend/out

# Wake word: set WAKE_WORD=1 to make the agent listen only after "hey livekit".
# Detection scores are logged (log level DEBUG) — tune WAKE_WORD_THRESHOLD to
# your microphone if needed.
# WAKE_WORD=1
# WAKE_WORD_THRESHOLD=0.5
